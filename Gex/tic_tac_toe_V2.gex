xCount = 0 # Cell trackers
yCount = 0

# Cell symbol storage
g0 = 0
g1 = 0
g2 = 0
g3 = 0
g4 = 0
g5 = 0
g6 = 0
g7 = 0
g8 = 0

# Bool to check for empty cell
clearCell = True

# Bool to check if it's turn 1
turn1 = True

# Start game
NewGame("X")

def NewGame(startSymbol):
    grid(3,3) # This clears the grid
    g0 = 0
    g1 = 0
    g2 = 0
    g3 = 0
    g4 = 0
    g5 = 0
    g6 = 0
    g7 = 0
    g8 = 0
    xCount = 0
    yCount = 0
    turn1 = True
    Turn(startSymbol)

def Turn(symbol):
    selecting = True
    while selecting:
        if InputLeft():
            MoveLeft()
            if xCount != 0:
                xCount = xCount - 1

        elif InputRight():
            MoveRight()
            if xCount != 2:
                xCount = xCount + 1

        elif InputUp():
            MoveUp()
            if yCount != 0:
                yCount = yCount - 1

        elif InputDown():
            MoveDown()
            if yCount != 2:
                yCount = yCount + 1

        elif InputA():
            turn1 = False
            CurrentCellClear()
            if clearCell:
                Draw(symbol)
                selecting = False
                if xCount == 0:
                    if yCount == 0:
                        g0 = symbol
                    elif yCount == 1:
                        g1 = symbol
                    elif yCount == 2:
                        g2 = symbol
                elif xCount == 1:
                    if yCount == 0:
                        g3 = symbol
                    elif yCount == 1:
                        g4 = symbol
                    elif yCount == 2:
                        g5 = symbol
                elif xCount == 2:
                    if yCount == 0:
                        g6 = symbol
                    elif yCount == 1:
                        g7 = symbol
                    elif yCount == 2:
                        g8 = symbol
        elif InputB():
            if turn1 == False:
                NewGame("X")

    CheckWin(symbol)
    if symbol == "X":
        Turn("O")
    else:
        Turn("X")

def CurrentCellClear():
    if xCount == 0:
        if yCount == 0:
            if g0 == 0:
                clearCell = True
            else:
                clearCell = False
        elif yCount == 1:
            if g1 == 0:
                clearCell = True
            else:
                clearCell = False
        elif yCount == 2:
            if g2 == 0:
                clearCell = True
            else:
                clearCell = False
    elif xCount == 1:
        if yCount == 0:
            if g3 == 0:
                clearCell = True
            else:
                clearCell = False
        elif yCount == 1:
            if g4 == 0:
                clearCell = True
            else:
                clearCell = False
        elif yCount == 2:
            if g5 == 0:
                clearCell = True
            else:
                clearCell = False
    elif xCount == 2:
        if yCount == 0:
            if g6 == 0:
                clearCell = True
            else:
                clearCell = False
        elif yCount == 1:
            if g7 == 0:
                clearCell = True
            else:
                clearCell = False
        elif yCount == 2:
            if g8 == 0:
                clearCell = True
            else:
                clearCell = False
    else:
        clearCell = False

def CheckWin(symbol):
    if g0 == symbol:
        if g1 == symbol:
            if g2 == symbol:
                Win(symbol)
        if g4 == symbol:
            if g8 == symbol:
                Win(symbol)
        if g3 == symbol:
            if g6 == symbol:
                Win(symbol)
    if g1 == symbol:
        if g4 == symbol:
            if g7 == symbol:
                Win(symbol)
    if g2 == symbol:
        if g4 == symbol:
            if g6 == symbol:
                Win(symbol)
        if g5 == symbol:
            if g8 == symbol:
                Win(symbol)
    if g3 == symbol:
        if g4 == symbol:
            if g5 == symbol:
                Win(symbol)
    if g6 == symbol:
        if g7 == symbol:
            if g8 == symbol:
                Win(symbol)

def Win(symbol):
    grid(3,3)
    MoveRight()
    Draw(symbol)
    MoveLeft()
    MoveDown()
    Draw("W")
    MoveRight()
    Draw("o")
    MoveRight()
    Draw("n")
    MoveDown()
    MoveLeft()
    while 1:
        if InputB():
            NewGame(symbol)