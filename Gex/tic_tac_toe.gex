def Turn(symbol):
    selecting = True
    while selecting:
        if InputLeft():
            MoveLeft()
        elif InputRight():
            MoveRight()

        elif InputUp():
            MoveUp()

        elif InputDown():
            MoveDown()

        elif InputA():
            Draw(symbol)
            selecting = False
        elif InputB():
            grid(3,3) # This clears the grid
            symbol = "X"

    if symbol == "X":
        Turn("O")
    else:
        Turn("X")

grid(3,3)
Turn("X")